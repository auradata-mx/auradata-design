{
  "name": "registry",
  "private": true,
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run registry",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "registry": "node scripts/registry.mjs && shadcn build registry.json --cwd .. --output registry/public/r",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --project=storybook",
    "test:visual": "playwright test",
    "test:visual:docker": "docker run --rm --ipc=host -v \"$PWD/..\":/work -w /work/registry mcr.microsoft.com/playwright:v1.65.1-noble npx playwright test",
    "test:unit": "vitest run --project=unit"
  },
  "dependencies": {
    "@auradata/tokens": "*",
    "@base-ui/react": "^1.9.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.77.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.11.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser-playwright": "^5.1.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.8",
    "globals": "^17",
    "playwright": "^1.65.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.8",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.1.1"
  }
}
