{
  "name": "@cristianruben-dev/auradata-tokens",
  "version": "0.2.0",
  "license": "UNLICENSED",
  "description": "AuraData brand tokens for every product: CSS variables, Tailwind 4, shadcn, Docusaurus, antd and ECharts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianruben-dev/auradata-design.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "files": ["dist", "assets"],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./shadcn.css": "./dist/shadcn.css",
    "./shadcn-theme.json": "./dist/shadcn-theme.json",
    "./tailwind.css": "./dist/tailwind.css",
    "./infima.css": "./dist/infima.css",
    "./antd.json": "./dist/antd.json",
    "./echarts.json": "./dist/echarts.json",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "prepack": "node build.mjs"
  },
  "devDependencies": {
    "style-dictionary": "5.8.0",
    "vitest": "5.1.1"
  }
}
