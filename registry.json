{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "auradata",
  "homepage": "https://auradata.mx",
  "items": [
    {
      "name": "auradata-theme",
      "type": "registry:theme",
      "title": "AuraData theme",
      "description": "The AuraData brand: Azul Aura, Outfit and Geist Mono, light and dark, and its focus ring.",
      "cssVars": {
        "theme": {
          "font-sans": "Outfit, -apple-system, 'Segoe UI', sans-serif",
          "font-mono": "'Geist Mono', ui-monospace, SFMono-Regular, monospace",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)",
          "color-info": "var(--info)",
          "color-info-foreground": "var(--info-foreground)",
          "color-chart-6": "var(--chart-6)",
          "color-chart-7": "var(--chart-7)",
          "color-chart-8": "var(--chart-8)"
        },
        "light": {
          "background": "#FFFFFF",
          "foreground": "#0A0A0F",
          "card": "#FFFFFF",
          "card-foreground": "#0A0A0F",
          "popover": "#FFFFFF",
          "popover-foreground": "#0A0A0F",
          "primary": "#2563EB",
          "primary-foreground": "#FFFFFF",
          "secondary": "#F5F5F5",
          "secondary-foreground": "#0A0A0F",
          "muted": "#F5F5F5",
          "muted-foreground": "#666666",
          "accent": "#F5F5F5",
          "accent-foreground": "#0A0A0F",
          "destructive": "#DC2626",
          "destructive-foreground": "#FFFFFF",
          "success": "#059669",
          "success-foreground": "#0A0A0F",
          "warning": "#D97706",
          "warning-foreground": "#0A0A0F",
          "info": "#2563EB",
          "info-foreground": "#FFFFFF",
          "border": "#E5E5E5",
          "input": "#E5E5E5",
          "control-border": "#858585",
          "ring": "#181818",
          "chart-1": "#2563EB",
          "chart-2": "#7C3AED",
          "chart-3": "#10B981",
          "chart-4": "#F59E0B",
          "chart-5": "#EC4899",
          "chart-6": "#06B6D4",
          "chart-7": "#F97316",
          "chart-8": "#64748B",
          "gradient-brand": "linear-gradient(100deg, #2563EB 0%, #7C3AED 55%, #10B981 100%)",
          "radius": "8px",
          "sidebar": "#FFFFFF",
          "sidebar-foreground": "#0A0A0F",
          "sidebar-primary": "#2563EB",
          "sidebar-primary-foreground": "#FFFFFF",
          "sidebar-accent": "#F5F5F5",
          "sidebar-accent-foreground": "#0A0A0F",
          "sidebar-border": "#E5E5E5",
          "sidebar-ring": "#181818"
        },
        "dark": {
          "background": "#111117",
          "foreground": "#F5F5F7",
          "card": "#111117",
          "card-foreground": "#F5F5F7",
          "popover": "#191921",
          "popover-foreground": "#F5F5F7",
          "primary": "#3B82F6",
          "primary-foreground": "#0A0A0F",
          "secondary": "#1C1C24",
          "secondary-foreground": "#F5F5F7",
          "muted": "#1C1C24",
          "muted-foreground": "#A3A3AD",
          "accent": "#1C1C24",
          "accent-foreground": "#F5F5F7",
          "destructive": "#F87171",
          "destructive-foreground": "#0A0A0F",
          "success": "#34D399",
          "success-foreground": "#0A0A0F",
          "warning": "#F5B544",
          "warning-foreground": "#0A0A0F",
          "info": "#3B82F6",
          "info-foreground": "#0A0A0F",
          "border": "#26262F",
          "input": "#26262F",
          "control-border": "#6B6B76",
          "ring": "#F5F5F7",
          "chart-1": "#2563EB",
          "chart-2": "#7C3AED",
          "chart-3": "#10B981",
          "chart-4": "#F59E0B",
          "chart-5": "#EC4899",
          "chart-6": "#06B6D4",
          "chart-7": "#F97316",
          "chart-8": "#64748B",
          "gradient-brand": "linear-gradient(100deg, #2563EB 0%, #7C3AED 55%, #10B981 100%)",
          "radius": "8px",
          "sidebar": "#111117",
          "sidebar-foreground": "#F5F5F7",
          "sidebar-primary": "#3B82F6",
          "sidebar-primary-foreground": "#0A0A0F",
          "sidebar-accent": "#1C1C24",
          "sidebar-accent-foreground": "#F5F5F7",
          "sidebar-border": "#26262F",
          "sidebar-ring": "#F5F5F7"
        }
      },
      "css": {
        "@layer base": {
          ":focus-visible": {
            "outline": "2px solid var(--ring)",
            "outline-offset": "2px"
          },
          ":where([data-slot=\"checkbox\"], [data-slot=\"radio-group-item\"])": {
            "--input": "var(--control-border)"
          }
        },
        ":where([class*=\"focus-visible:ring-\"]:not([class~=\"focus-visible:ring-0\"], [data-slot=\"field-label\"]:has(> [data-slot=\"field\"]) *)):focus-visible,\n:where([class*=\"focus-visible:ring-\"]):has(> input:focus-visible),\n:where([class*=\"focus-within:ring-\"]:not([class*=\"focus-within:ring-0\"])):has(:focus-visible),\n:where([data-slot=\"input-group\"]:not([data-slot=\"combobox-content\"] *)):has([data-slot=\"input-group-control\"]:focus-visible),\n:where([data-slot=\"code-block\"]):has(> [data-slot=\"code-block-content\"]:focus-visible),\n:where([data-slot=\"field-label\"]:has(> [data-slot=\"field\"])):has(:focus-visible)": {
          "outline": "2px solid var(--ring)",
          "outline-offset": "2px",
          "--tw-ring-shadow": "0 0 #0000"
        },
        ":where([data-slot$=\"viewport\"]):focus-visible": {
          "outline-offset": "-2px"
        }
      }
    },
